# Copy to .env and fill in. Never commit .env.
POSTGRES_DB=society_ledger
POSTGRES_USER=ledger_owner
POSTGRES_PASSWORD=change-me-owner-password
APP_DB_PASSWORD=change-me-app-password
# At least 16 characters, random. Used to protect login codes and session tokens.
SOCIETY_LEDGER_AUTH_SECRET=change-me-to-a-long-random-string
# Local trial only: "dev" logs one-time codes instead of emailing them. Leave empty in production.
SPRING_PROFILES_ACTIVE=dev
# Real email (leave SOCIETY_LEDGER_MAIL_ENABLED=false while trying it locally)
SOCIETY_LEDGER_MAIL_ENABLED=false
SOCIETY_LEDGER_MAIL_FROM=Society Ledger <login@your-domain>
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
